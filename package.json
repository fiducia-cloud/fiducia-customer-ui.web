{
  "name": "fiducia-customer-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "check": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "test:browser": "npm run build && node --test --test-concurrency=1 tests/*.test.mjs",
    "test:browser:playwright": "npm run build && node --test tests/customer-playwright.test.mjs",
    "test:browser:puppeteer": "npm run build && node --test tests/customer-puppeteer.test.mjs"
  },
  "dependencies": {
    "@fiducia/interfaces": "file:../fiducia-interfaces",
    "@supabase/supabase-js": "^2.89.0",
    "htmx.org": "^2.0.8",
    "vite": "^7.2.7"
  },
  "devDependencies": {
    "@fiducia/test-config": "file:../fiducia-test-config",
    "@types/node": "^24.10.2",
    "playwright": "^1.61.1",
    "puppeteer": "^25.2.1",
    "typescript": "^5.9.3"
  }
}
